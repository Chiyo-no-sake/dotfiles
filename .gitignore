.env

.var
appimages
pyenvs

# Machine-local hyprland overrides
.config/hypr/monitors-local.conf
.config/hypr/hyprlock-local.conf

# Matugen-generated color files (regenerated per wallpaper)
.config/hypr/colors.conf
.config/waybar/colors.css
.config/kitty/colors-dynamic.conf
.config/rofi/colors/colors.rasi
.config/fuzzel/colors.ini
.config/swaync/colors.css
.config/matugen/generated/
.config/lazygit/config.yml
.config/nvim/lua/matugen_colors.lua

# Python build artifacts
__pycache__/
*.pyc

# Per-mode kitty overrides (font/opacity), regenerated by theme-toggle.sh
.config/kitty/mode.conf

# Generated by matugen for quickshell
.config/quickshell/colors.json

# Runtime-generated icon caches (apps write through the stow symlink)
.local/share/icons/hicolor/icon-theme.cache
.local/share/icons/hicolor/*x*/

# Serena tooling state
.serena/
