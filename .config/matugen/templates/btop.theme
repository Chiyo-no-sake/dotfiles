# Generated by matugen - Material You colors for btop

# Main bg and fg
theme[main_bg]="{{colors.surface.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"

# Title color
theme[title]="{{colors.on_surface.default.hex}}"

# Highlight color
theme[hi_fg]="{{colors.primary.default.hex}}"

# Selected item
theme[selected_bg]="{{colors.primary_container.default.hex}}"
theme[selected_fg]="{{colors.on_primary_container.default.hex}}"

# Inactive/unfocused text
theme[inactive_fg]="{{colors.outline.default.hex}}"

# Graph text
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"

# Misc proc info
theme[proc_misc]="{{colors.primary.default.hex}}"

# Meter background
theme[meter_bg]="{{colors.outline_variant.default.hex}}"

# Box outlines
theme[cpu_box]="{{colors.primary.default.hex}}"
theme[mem_box]="{{colors.secondary.default.hex}}"
theme[net_box]="{{colors.tertiary.default.hex}}"
theme[proc_box]="{{colors.outline.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

# CPU graph gradient
theme[cpu_start]="{{colors.primary.default.hex}}"
theme[cpu_mid]="{{colors.secondary.default.hex}}"
theme[cpu_end]="{{colors.error.default.hex}}"

# Temperature gradient
theme[temp_start]="{{colors.tertiary.default.hex}}"
theme[temp_mid]="{{colors.secondary.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

# Memory: free
theme[free_start]="{{colors.tertiary.default.hex}}"
theme[free_mid]="{{colors.tertiary.default.hex}}"
theme[free_end]="{{colors.tertiary_container.default.hex}}"

# Memory: cached
theme[cached_start]="{{colors.secondary.default.hex}}"
theme[cached_mid]="{{colors.secondary.default.hex}}"
theme[cached_end]="{{colors.secondary_container.default.hex}}"

# Memory: available
theme[available_start]="{{colors.primary.default.hex}}"
theme[available_mid]="{{colors.primary.default.hex}}"
theme[available_end]="{{colors.primary_container.default.hex}}"

# Memory: used
theme[used_start]="{{colors.tertiary.default.hex}}"
theme[used_mid]="{{colors.secondary.default.hex}}"
theme[used_end]="{{colors.error.default.hex}}"

# Network: download
theme[download_start]="{{colors.primary.default.hex}}"
theme[download_mid]="{{colors.primary.default.hex}}"
theme[download_end]="{{colors.primary_container.default.hex}}"

# Network: upload
theme[upload_start]="{{colors.secondary.default.hex}}"
theme[upload_mid]="{{colors.secondary.default.hex}}"
theme[upload_end]="{{colors.secondary_container.default.hex}}"

# Process graph
theme[process_start]="{{colors.primary.default.hex}}"
theme[process_mid]="{{colors.secondary.default.hex}}"
theme[process_end]="{{colors.tertiary.default.hex}}"
