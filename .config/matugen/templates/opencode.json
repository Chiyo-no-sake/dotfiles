{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "{{colors.background.default.hex}}",
    "fg": "{{colors.on_background.default.hex}}",
    "muted": "{{colors.on_surface_variant.default.hex}}",
    "accent": "{{colors.primary.default.hex}}",
    "accent2": "{{colors.secondary.default.hex}}",
    "accent3": "{{colors.tertiary.default.hex}}",
    "err": "{{colors.error.default.hex}}",
    "panel": "{{colors.surface_bright.default.hex}}",
    "element": "{{colors.surface_variant.default.hex}}",
    "line": "{{colors.outline.default.hex}}"
  },
  "theme": {
    "primary": "accent",
    "secondary": "accent2",
    "accent": "accent3",
    "error": "err",
    "warning": "accent3",
    "success": "#5ec98a",
    "info": "accent2",
    "text": "fg",
    "textMuted": "muted",
    "background": "none",
    "backgroundPanel": "panel",
    "backgroundElement": "element",
    "backgroundMenu": "element",
    "border": "line",
    "borderActive": "accent",
    "borderSubtle": "element",
    "diffAdded": "#6ecf9c",
    "diffRemoved": "err",
    "diffContext": "muted",
    "diffHunkHeader": "muted",
    "diffHighlightAdded": "#6ecf9c",
    "diffHighlightRemoved": "err",
    "diffAddedBg": "none",
    "diffRemovedBg": "none",
    "diffContextBg": "none",
    "diffLineNumber": "muted",
    "diffAddedLineNumberBg": "none",
    "diffRemovedLineNumberBg": "none",
    "markdownText": "fg",
    "markdownHeading": "accent",
    "markdownLink": "accent3",
    "markdownLinkText": "accent2",
    "markdownCode": "accent3",
    "markdownBlockQuote": "muted",
    "markdownEmph": "accent3",
    "markdownStrong": "accent",
    "markdownHorizontalRule": "muted",
    "markdownListItem": "accent",
    "markdownListEnumeration": "accent2",
    "markdownImage": "accent2",
    "markdownImageText": "muted",
    "markdownCodeBlock": "fg",
    "syntaxComment": "muted",
    "syntaxKeyword": "accent2",
    "syntaxFunction": "accent",
    "syntaxVariable": "accent3",
    "syntaxString": "accent3",
    "syntaxNumber": "accent",
    "syntaxType": "accent2",
    "syntaxOperator": "accent2",
    "syntaxPunctuation": "fg"
  }
}
