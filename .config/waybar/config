[
{
    "name": "main",
    "layer": "top",
    "position": "top",
    "width": "100%",
    // Choose the order of the modules
    "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-center": [
      "custom/layout",
      "clock",
      "custom/win-count",
    ],
    "modules-right": [
      "custom/cpu-sparkline",
      "memory",
      "custom/network-speed",
      "pulseaudio",
      "custom/bluetooth",
      "tray",
      "custom/power-profile",
      "battery",
      "custom/cc"
    ],
    "hyprland/workspaces": {
         //"format": " {icon} ",
         //"format-icons": {
         //    "default": "",
         //},
     },
    "tray": {
        "icon-size": 16,
        "spacing": 5
    },
    "custom/music2": {
        "format": "  {}",
        "interval": 1,
        "escape": true,
        "tooltip": false,
        "exec": "~/dotfiles/.config/waybar/modules/player-meta.sh",
        "max-length": 60
    },
    "custom/music-controls-prev": {
        "format": "  ",
        "escape": true,
        "tooltip": false,
        "on-click": "playerctl previous",
        "max-length": 50
    },
    "custom/music-controls-next": {
        "format": "  ",
        "escape": true,
        "tooltip": false,
        "on-click": "playerctl next",
        "max-length": 50
    },
    "custom/music-controls-status": {
        "format": "{}",
        "exec": "~/dotfiles/.config/waybar/modules/player-stat.sh",
        "escape": true,
        "tooltip": false,
        "on-click": "playerctl play-pause",
        "max-length": 50,
        "return-type": "json"
    },
    "custom/emoji": {
        "format": "",
        "escape": "true",
        "on-click": "BEMOJI_PICKER_CMD=\"fuzzel --font CaskaydiaCove Nerd Font -d\" bemoji"
    },
    "custom/cc": {
        "format": " 󰄛 ",
        "on-click": "swaync-client -t"
    },
    "custom/layout": {
        "format": "{}",
        "interval": 1,
        "exec": "$HOME/dotfiles/.config/waybar/modules/layout-toggle.sh",
        "on-click": "$HOME/dotfiles/.config/waybar/modules/layout-toggle.sh toggle",
        "exec-on-event": true,
        "return-type": "json",
        "tooltip": true
    },
    "clock": {
        "timezone": "Europe/Rome",
        "locale": "it_IT.UTF-8",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%d/%m/%Y}",
        "format": "{:%a %d/%m - %H:%M}"
    },
    "custom/win-count": {
        "format": "{}",
        "interval": 1,
        "exec": "hyprctl activeworkspace -j | jq -r '.windows'",
        "tooltip": false
    },
    "backlight": {
        "format": " {percent}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}",
        "format-charging": "󰂅",
        "format-plugged": "󰚥",
        "format-alt": "{icon}",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", " ", " "]
        },
        "on-click": "$HOME/dotfiles/pyenvs/pyprland/.venv/bin/pypr toggle pavucontrol"
    },
    "custom/bluetooth": {
      "format": "{}",
      "interval": 1,
      "exec": "$HOME/.local/share/bin/get_bluetooth_status_waybar",
      "escape": "true",
      "on-click": "$HOME/dotfiles/pyenvs/pyprland/.venv/bin/pypr toggle blueman"
    },
    "custom/cpu-sparkline": {
      "format": "{}",
      "interval": 2,
      "exec": "$HOME/dotfiles/.config/waybar/modules/cpu-sparkline.sh",
      "tooltip": false
    },
    "memory": {
      "format": "{icon} {percentage}%",
      "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
      "tooltip-format": "{used:0.1f}G / {total:0.1f}G ({percentage}%)",
      "interval": 5
    },
    "custom/power-profile": {
      "format": "{}",
      "interval": 5,
      "exec": "/home/kalu/dotfiles/.config/waybar/modules/power-profile.sh",
      "on-click": "/home/kalu/dotfiles/.config/waybar/modules/power-profile.sh cycle",
      "exec-on-event": true
    },
    "custom/network-speed": {
      "format": "{}",
      "interval": 2,
      "exec": "$HOME/dotfiles/.config/waybar/modules/network-speed.sh",
      "tooltip": false,
      "min-length": 16
    }
}
]
