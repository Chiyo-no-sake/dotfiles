profile docked_home {
    output "Huawei Technologies Co. Inc. ZQE-CAA 0xC080F622" enable mode 3440x1440@165Hz position 0,0
    output eDP-1 disable
}

profile docked_work {
    output "Xiaomi Corporation Mi monitor 5505610116880" enable mode 3440x1440@165Hz position 0,0
    output eDP-1 disable
}

# Laptop only (no external connected)
profile undocked {
    output eDP-1 enable mode 2560x1600@60Hz position 0,0 scale 1
}
